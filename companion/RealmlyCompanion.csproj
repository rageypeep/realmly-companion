<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/realmly-companion.ico</ApplicationIcon>
    <AssemblyName>RealmlyCompanion</AssemblyName>
    <RootNamespace>RealmlyCompanion</RootNamespace>
    <Version>0.1.33</Version>
    <AssemblyVersion>0.1.33.0</AssemblyVersion>
    <FileVersion>0.1.33.0</FileVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(StoreDistribution)' == 'true'">
    <DefineConstants>$(DefineConstants);REALMLY_STORE</DefineConstants>
    <Version>0.2.7</Version>
    <AssemblyVersion>0.2.7.0</AssemblyVersion>
    <FileVersion>0.2.7.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="SelfUpdater.cs" Condition="'$(StoreDistribution)' == 'true'" />
    <EmbeddedResource Include="SelfUpdate.ps1" LogicalName="RealmlyCompanion.SelfUpdate.ps1" Condition="'$(StoreDistribution)' != 'true'" />
    <EmbeddedResource Include="Assets/realmly-companion.ico" LogicalName="RealmlyCompanion.Icon.ico" />
  </ItemGroup>
</Project>
