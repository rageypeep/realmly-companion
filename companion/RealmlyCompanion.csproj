<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/realmly-companion.ico</ApplicationIcon>
    <AssemblyName>RealmlyCompanion</AssemblyName>
    <RootNamespace>RealmlyCompanion</RootNamespace>
    <Version>0.1.26</Version>
    <AssemblyVersion>0.1.26.0</AssemblyVersion>
    <FileVersion>0.1.26.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="SelfUpdate.ps1" LogicalName="RealmlyCompanion.SelfUpdate.ps1" />
    <EmbeddedResource Include="Assets/realmly-companion.ico" LogicalName="RealmlyCompanion.Icon.ico" />
  </ItemGroup>
</Project>
